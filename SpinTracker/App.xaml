<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SpinTracker.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#1E3A5F</Color>
            <Color x:Key="SecondaryColor">#2C5282</Color>
            <Color x:Key="AccentColor">#38B2AC</Color>
            <Color x:Key="BackgroundColor">#F7FAFC</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="TextColor">#2D3748</Color>
            <Color x:Key="MutedColor">#718096</Color>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#1E3A5F"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>