{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "hud",
  "description": "The HUD windows laid over poker tables: they listen to the HUD events and call the few commands they need",
  "windows": [
    "hud-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-backend-request",
    "allow-hud-settings-get",
    "allow-hud-settings-set",
    "allow-hud-get-state",
    "allow-hud-set-panel-rects",
    "allow-frontend-log"
  ]
}
