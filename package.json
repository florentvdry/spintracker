{
  "name": "spintracker",
  "version": "1.1.7",
  "description": "Free, open-source poker tracker for Spin & Go tournaments: hand history import, leak detection, EV analysis, replayer and range research. 100% local.",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:install": "npm --prefix frontend install",
    "postinstall": "npm run frontend:install",
    "setup": "npm install"
  },
  "keywords": [
    "poker",
    "poker-tracker",
    "spin-and-go",
    "spin-and-gold",
    "hand-history",
    "poker-hud",
    "poker-analysis",
    "leak-finder",
    "range-analyzer",
    "hand-replayer",
    "winamax",
    "betclic",
    "unibet",
    "tauri",
    "rust",
    "react",
    "sqlite",
    "open-source"
  ],
  "homepage": "https://florentvdry.github.io/spintracker/",
  "bugs": {
    "url": "https://github.com/florentvdry/spintracker/issues"
  },
  "author": "SpinTracker contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florentvdry/spintracker.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
