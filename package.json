{
  "name": "poker-tracker-pro",
  "version": "1.0.0",
  "description": "Professional Poker Tracker with React UI, C# Backend, Leak Detection and EV Analysis",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run react:dev\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "build": "npm run react:build && npm run backend:build && electron-builder --win",
    "react:dev": "cd frontend && npm run dev",
    "react:build": "cd frontend && npm run build",
    "react:install": "cd frontend && npm install",
    "backend:build": "cd backend && dotnet publish -c Release -r win-x64 --self-contained true /p:PublishSingleFile=true /p:PublishReadyToRun=true",
    "postinstall": "npm run react:install",
    "setup": "npm install && npm run react:install && npm run backend:build"
  },
  "keywords": [
    "poker",
    "tracker",
    "spin-and-go",
    "electron",
    "react",
    "csharp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.spintracker.app",
    "productName": "SpinTracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/bin/Release/net8.0/win-x64/publish",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo.png",
      "publish": [
        {
          "provider": "generic",
          "url": "https://example.com/updates"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
