{
  "name": "poker-tracker-pro",
  "version": "2.0.0",
  "description": "Professional Poker Tracker with React UI, Python Backend, Leak Detection and EV Analysis",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run react:dev\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "build": "npm run react:build && electron-builder",
    "react:dev": "cd frontend && npm run dev",
    "react:build": "cd frontend && npm run build",
    "react:install": "cd frontend && npm install",
    "python:install": "pip install -r backend/requirements.txt",
    "postinstall": "npm run react:install",
    "setup": "npm install && npm run react:install && npm run python:install"
  },
  "keywords": [
    "poker",
    "tracker",
    "spin-and-go",
    "electron",
    "react",
    "python"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.pokertracker.app",
    "productName": "Poker Tracker Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
